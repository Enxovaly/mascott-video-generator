# Never commit the real key. Copy this file to .env.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_NAME=Enxovaly Mascot Lab

MASCOT_VIDEO_MODEL=bytedance/seedance-2.0
MASCOT_VIDEO_SIZE=480x480
MASCOT_VIDEO_DURATION=4
MASCOT_POLL_INTERVAL_MS=10000
MASCOT_POLL_TIMEOUT_MS=900000

MASCOT_REFERENCE_PATH=references/mascot-master.png
MASCOT_CHARACTER_SHEET_PATH=references/mascot-character-sheet.png
MASCOT_OUTPUT_DIR=outputs
